# CourseInsight Database Configuration
# ----------------------------------------------------
# 1. To use a local or live PostgreSQL DB, configure your credentials:
DATABASE_URL=postgresql://pgadmin:your-db-password@localhost:5432/your-db-name

# 2. Or leave empty/commented out to automatically run on local SQLite file database:
# DATABASE_URL=sqlite:///./courseinsight.db

# ----------------------------------------------------
# Security Configuration
# ----------------------------------------------------
# Replace this with a secure random key in production
JWT_SECRET=courseinsight_secure_random_jwt_secret_key_987654321
